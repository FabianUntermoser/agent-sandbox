{
  "$schema": "https://raw.githubusercontent.com/gotgenes/pi-packages/main/packages/pi-permission-system/schemas/permissions.schema.json",
  "debugLog": false,
  "permissionReviewLog": true,
  "yoloMode": true,
  "doublePressToConfirm": true,
  "permission": {
    "*": "allow",
    "external_directory": {
      "*": "ask"
    },
    "bash": {
      "*": "allow",
      "*down -v*": "ask",
      "*rm -rf*": "ask",
      "*docker volume rm*": "ask",
      "*make clean*": "ask",
      "*make wipe*": "ask",
      "git commit *": "allow",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "git tag *": "ask",
      "gh pr close *": "ask",
      "gh pr create *": "ask",
      "gh pr merge *": "ask",
      "gh pr review *": "ask",
      "gh pr reopen *": "ask",
      "gh pr comment *": "ask",
      "gh issue close *": "ask",
      "gh issue create *": "ask",
      "gh issue reopen *": "ask",
      "gh issue comment *": "ask",
      "gh release *": "ask",
      "gh run *": "ask",
      "gh workflow *": "ask",
      "gh repo create *": "ask",
      "gh repo fork *": "ask",
      "gh api *": "ask",
      "glab mr create*": "deny",
      "glab mr update*--description*": "deny",
      "glab mr update*-d *": "deny",
      "glab mr update*--title*": "deny",
      "glab mr update*-t *": "deny",
      "tmux kill-session *": "ask",
      "tmux kill-window *": "ask",
      "tmux kill-pane *": "ask",
      "npm publish *": "ask",
      "pnpm publish *": "ask",
      "yarn publish *": "ask",
      "docker push *": "ask",
      "docker buildx *": "ask",
      "make publish *": "ask",
      "*make publish*": "ask",
      "make release *": "ask",
      "*make release*": "ask",
      "make deploy *": "ask",
      "*make deploy*": "ask",
      "*passwd*": "deny",
      "*--user_pass*": "deny",
      "*--api_key*": "deny",
      "*--secret*": "deny",
      "*--password*": "deny"
    }
  }
}
